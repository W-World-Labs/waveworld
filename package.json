{
  "name": "waveworld",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:wave-wasm": "node scripts/build-wave-wasm.mjs",
    "dev": "vite",
    "dev:host": "npm run dev --prefix apps/host",
    "dev:atlas": "vite",
    "build": "tsc -b && vite build",
    "build:check": "npm run build && npm run check:formal-spa && node scripts/check-bundle-budget.mjs",
    "check:formal-spa": "node scripts/ci/assert-formal-spa.mjs",
    "build:host": "npm run build --prefix apps/host",
    "start:host": "npm run start --prefix apps/host",
    "preview": "vite preview",
    "test": "node scripts/ci/run-tests.mjs",
    "test:unit": "vitest run --exclude src/lib/knowledge-db/edge-detail-p95-smoke.test.ts",
    "test:perf": "vitest run src/lib/knowledge-db/edge-detail-p95-smoke.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:golden": "node --test scripts/research/golden-case.test.mjs && node --import tsx --test scripts/research/run-golden-case.test.ts scripts/research/diagnose-golden-gpu.test.ts scripts/research/preregistration-v2-draft.test.ts",
    "golden:verify": "node scripts/research/golden-case.mjs verify",
    "golden:run": "tsx scripts/research/run-golden-case.ts",
    "golden:gpu": "tsx scripts/research/run-golden-gpu.ts",
    "golden:gpu:diagnose": "tsx scripts/research/diagnose-golden-gpu.ts",
    "golden:gpu:diagnose:cpu": "tsx scripts/research/diagnose-golden-gpu.ts --cpu-only",
    "golden:draft:eval": "tsx scripts/research/evaluate-preregistration-v2-draft.ts",
    "golden:draft:write-summary": "tsx scripts/research/evaluate-preregistration-v2-draft.ts --write-summary",
    "golden:draft:check": "tsx scripts/research/evaluate-preregistration-v2-draft.ts --check-frozen",
    "golden:draft:peer-packet": "tsx scripts/research/evaluate-preregistration-v2-draft.ts --write-peer-packet",
    "golden:draft:check-peer-packet": "tsx scripts/research/evaluate-preregistration-v2-draft.ts --check-peer-packet",
    "budget": "node scripts/check-bundle-budget.mjs --total-kb 7500",
    "test:host": "npm run test --prefix apps/host",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:smoke && tsc -b && vite build && playwright test",
    "agent:once": "npm run agent:dev --prefix apps/lab -- once --url http://127.0.0.1:3001",
    "agent:submit": "npm run agent:dev --prefix apps/lab -- submit --url http://127.0.0.1:3001",
    "knowledge:releases": "tsx scripts/knowledge/list-releases.ts",
    "knowledge:ingest-once": "tsx scripts/knowledge/ingest-once.ts",
    "knowledge:offline-pipeline": "tsx scripts/knowledge/offline-pipeline.ts",
    "knowledge:db:migrate": "tsx scripts/knowledge/db-cli.ts migrate",
    "knowledge:db:status": "tsx scripts/knowledge/db-cli.ts status",
    "knowledge:inventory:check": "tsx scripts/knowledge/dump-inventory.ts --check",
    "knowledge:inventory:summary": "tsx scripts/knowledge/dump-inventory.ts --format=summary",
    "knowledge:db:path": "tsx scripts/knowledge/db-cli.ts path",
    "knowledge:db:http-p95": "tsx scripts/knowledge/edge-detail-http-p95-smoke.ts",
    "test:knowledge": "vitest run src/lib/knowledge src/lib/knowledge-db",
    "lab:preset-matrix": "node scripts/lab/preset-matrix-inventory.mjs",
    "coverage:capability": "node scripts/loops/capability-coverage.mjs",
    "coverage:capability:json": "node scripts/loops/capability-coverage.mjs --json",
    "coverage:capability:strict": "node scripts/loops/capability-coverage.mjs --strict",
    "test:smoke": "vitest run src/lib/sim/software-cases.test.ts src/lib/sim/software-cases-exec.test.ts src/lib/sim/signal-array.test.ts src/lib/sim/transient.test.ts src/lib/sim/faraday.test.ts src/lib/sim/spectrum-runnable-algos.test.ts src/lib/sim/trilateration.test.ts src/lib/sim/tdoa.test.ts src/lib/sim/stm.test.ts src/lib/sim/afm.test.ts src/lib/sim/phasedarray.test.ts src/lib/sim/nljd.test.ts src/lib/sim/antenna.test.ts src/lib/sim/antennalink.test.ts src/lib/sim/laser.test.ts src/lib/sim/module-compute.test.ts src/data/methods/moduleRegistry.test.ts src/lib/sim/simCapabilityCatalog.test.ts src/lib/hooks/rafLoopCore.test.ts src/lib/visibilityRaf.test.ts src/lib/lab/optics-lab.test.ts src/lib/webgpu/gpuFallback.test.ts src/lib/playback.test.ts src/lib/labEntry.test.ts --maxWorkers=2",
    "test:navigation": "node scripts/ci/navigation-smoke.mjs",
    "test:jobs-ui": "node scripts/ci/jobs-ui-smoke.mjs",
    "test:module-ui": "node scripts/ci/simulation-module-smoke.mjs",
    "test:agent:browser": "node scripts/ci/wsim-vite-kernel-smoke.mjs && NODE_PATH=\"$PWD/apps/host/node_modules\" tsx --tsconfig apps/host/tsconfig.json scripts/ci/browser-agent-smoke.ts",
    "test:agent:browser:gpu": "npm run test:agent:browser -- --webgpu",
    "test:software-cases": "WAVEWORLD_SOFTWARE_CASES_FULL=1 vitest run src/lib/sim/software-cases.test.ts src/lib/sim/software-cases-exec.test.ts src/lib/sim/module-compute.test.ts --maxWorkers=2",
    "test:structural-result": "NODE_PATH=\"$PWD/apps/host/node_modules\" tsx --tsconfig apps/host/tsconfig.json --test scripts/ci/structural-result-smoke.ts",
    "preinstall": "node scripts/verify-wsim-vendor.mjs",
    "prebuild": "node scripts/prepare-source-assets.mjs"
  },
  "dependencies": {
    "@w-sim/contracts": "file:vendor/w-sim/w-sim-contracts-0.3.0.tgz",
    "@w-sim/kit": "file:vendor/w-sim/w-sim-kit-0.3.0.tgz",
    "@w-sim/runtime": "file:vendor/w-sim/w-sim-runtime-0.3.0.tgz",
    "@w-sim/solvers-lbm": "file:vendor/w-sim/w-sim-solvers-lbm-0.3.0.tgz",
    "@w-sim/solvers-structural": "file:vendor/w-sim/w-sim-solvers-structural-0.3.0.tgz",
    "@w-sim/solvers-thermal": "file:vendor/w-sim/w-sim-solvers-thermal-0.3.0.tgz",
    "fflate": "0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@webgpu/types": "^0.1.71",
    "autoprefixer": "^10.6.2",
    "happy-dom": "^20.14.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
