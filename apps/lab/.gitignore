# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# task queue / agent local state
/data/
agent/node_modules/
validation/node_modules/

# agent binary build artifacts
/bin/tuanliu-agent
/bin/tuanliu-agent.cjs
/bin/sea-prep.blob
/bin/sea-config.json
/bin/*.dawn.node
/bin/native/
/bin/README.md

# large local only
*.log
tsconfig.tsbuildinfo
test-results/
